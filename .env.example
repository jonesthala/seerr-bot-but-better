# Copy to .env and fill in. Keep .env private (chmod 600): it holds the bot token and the Seerr API key.

# --- Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# (not the Public Key or the Client Secret; no quotes needed)
DISCORD_TOKEN=
# Turn on Developer Mode (User Settings -> Advanced), then right-click -> "Copy ID"
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Only members with this role may search and request. Empty = everyone in the channel.
DISCORD_REQUEST_ROLE_ID=
# Who may delete movies and shows with /löschen: members with this role and/or these user IDs
# (comma-separated). Leave both empty to switch deleting off.
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_USER_IDS=

# --- Seerr
# Address the bot uses to reach Seerr
SEERR_URL=http://localhost:5055
# Seerr -> Settings -> General -> API Key
SEERR_API_KEY=
# Language of titles and descriptions
SEERR_LANGUAGE=de
# Empty: requests are made as the owner of the API key (an admin), so they are approved at once.
# A Seerr user ID: requests are made as that user, so its permissions apply. Without "auto-approve" they
# wait for approval (in Seerr, or with buttons in Discord when admins are set).
SEERR_USER_ID=
# Optional link to Seerr in the bot's messages, e.g. http://seerr.home (only if everyone in the channel can open it)
SEERR_PUBLIC_URL=

# --- Free space
# New requests are refused below this many GB free in Radarr's/Sonarr's folders; the bot also warns in the channel.
MIN_FREE_GB=15
# Below this many GB, running downloads are paused in qBittorrent (needs QBITTORRENT_* below); 0 = off.
BRAKE_FREE_GB=3
# After a movie or episode was watched to the end in Jellyfin, ask the admins by DM whether to delete it. 0 = off.
WATCHED_ASK=1
# Every hour, search monitored episodes that come out within this many days (streaming often publishes before the
# TV date). 0 = off.
EARLY_SEARCH_DAYS=4

# --- Approvals and notifications
# New requests that wait for approval get "Freigeben"/"Ablehnen" buttons (only admins can click).
# Needs DISCORD_ADMIN_USER_IDS or DISCORD_ADMIN_ROLE_ID. Empty = in DISCORD_CHANNEL_ID.
DISCORD_APPROVAL_CHANNEL_ID=
# Address for the "Jetzt ansehen" button, as people in the channel open Jellyfin, e.g. http://jellyfin.home
# Empty = the address Seerr itself uses for Jellyfin.
JELLYFIN_URL=

# --- /jellyfin-zugang: Jellyfin accounts for friends (optional, needs admins above)
# All four values are needed, otherwise the commands don't appear.
# How the bot reaches Jellyfin, e.g. http://192.168.1.30:8096
JELLYFIN_API_URL=
# Jellyfin → Dashboard → API Keys. Admin rights, keep it private.
JELLYFIN_API_KEY=
# The address friends type into the Jellyfin app, e.g. http://100.101.102.103:8096 (Tailscale IP)
JELLYFIN_FRIEND_URL=
# Tailscale → Machines → Jellyfin → Share → Copy invite link → "Reusable link" on → Copy share link
TAILSCALE_SHARE_URL=
# Libraries friends may see, comma-separated. Empty = all.
JELLYFIN_FRIEND_LIBRARIES=Movies,Shows
# Bitrate limit for friends streaming from outside, in Mbit/s. 0 = none.
JELLYFIN_FRIEND_BITRATE_MBIT=4

# --- /löschen also removes the torrents in qBittorrent (optional)
# qBittorrent WebUI login (qBittorrent 4.x has no API keys), plus Sonarr/Radarr to know which torrents belong
# to a title (only read). Empty = /löschen leaves the torrents.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# --- Limit per person (admins have no limit)
# At most REQUEST_LIMIT requests within REQUEST_LIMIT_DAYS days. 0 = no limit.
REQUEST_LIMIT=0
REQUEST_LIMIT_DAYS=7

# --- Weekly post of what's new in the library, e.g. "sun 18:00" (German day names work too: "so 18:00").
# Empty = off.
WEEKLY_DIGEST=
# Time zone for the weekly post and the dates the bot shows, e.g. Europe/Zurich
TIMEZONE=UTC

# --- Quality or language to choose from when requesting
# Names of quality profiles in Radarr (movies) and Sonarr (shows), comma-separated, e.g. HD-1080p,Ultra-HD
# The first one is preselected. Empty = Seerr's default profile, no choice.
MOVIE_PROFILES=
TV_PROFILES=

# --- Admin panel in the browser (optional)
# Everything from Discord on one page: status, approvals, "Geschaut, löschen?", downloads, search and request,
# single episodes, following, calendar, deleting. Log in with a Jellyfin administrator account (needs
# JELLYFIN_API_URL above). Plain HTTP: publish the port only to your home network or Tailscale.
# The port inside the container; publish it with `docker run -p 8095:8095` or `ports:` in docker-compose.yml. 0 = off.
PANEL_PORT=0
# Discord account the panel acts for (abos, "it's there" messages). Empty = the only ID in DISCORD_ADMIN_USER_IDS.
PANEL_DISCORD_USER_ID=
# Optional: the Minecraft bot (github.com/jonesthala/mc-discord-bot) as its own page: the address of its admin API
# (WEB_PORT there) and its WEB_TOKEN.
PANEL_MC_URL=
PANEL_MC_TOKEN=
# Optional: a to-do page from Markdown notes (e.g. an Obsidian vault), read only. A folder the bot can read (mount it,
# e.g. -v /opt/notes:/notes:ro) and the notes in it, comma-separated. Checkboxes are tasks, other list items ideas.
PANEL_TODO_DIR=
PANEL_TODO_FILES=
# Vault name for "In Obsidian öffnen" links (the folder name of the vault)
PANEL_OBSIDIAN_VAULT=
