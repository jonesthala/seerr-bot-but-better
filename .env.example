# Copy to .env and fill in. Keep .env private (chmod 600): it holds the bot token and the Seerr API key.

# --- Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# (not the Public Key or the Client Secret; no quotes needed)
DISCORD_TOKEN=
# Turn on Developer Mode (User Settings -> Advanced), then right-click -> "Copy ID"
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Only members with this role may search and request. Empty = everyone in the channel.
DISCORD_REQUEST_ROLE_ID=
# Who may delete movies and shows with /löschen: members with this role and/or these user IDs
# (comma-separated). Leave both empty to switch deleting off.
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_USER_IDS=

# --- Seerr
# Address the bot uses to reach Seerr
SEERR_URL=http://localhost:5055
# Seerr -> Settings -> General -> API Key
SEERR_API_KEY=
# Language of titles and descriptions
SEERR_LANGUAGE=de
# Empty: requests are made as the owner of the API key (an admin), so they are approved at once.
# A Seerr user ID: requests are made as that user, so its permissions apply. Without "auto-approve" they
# wait for approval (in Seerr, or with buttons in Discord when admins are set).
SEERR_USER_ID=
# Optional link to Seerr in the bot's messages, e.g. http://seerr.home (only if everyone in the channel can open it)
SEERR_PUBLIC_URL=

# --- Free space
# New requests are refused below this many GB free in Radarr's/Sonarr's folders; the bot also warns in the channel.
MIN_FREE_GB=15

# --- Approvals and notifications
# New requests that wait for approval get "Freigeben"/"Ablehnen" buttons (only admins can click).
# Needs DISCORD_ADMIN_USER_IDS or DISCORD_ADMIN_ROLE_ID. Empty = in DISCORD_CHANNEL_ID.
DISCORD_APPROVAL_CHANNEL_ID=
# Address for the "Jetzt ansehen" button, as people in the channel open Jellyfin, e.g. http://jellyfin.home
# Empty = the address Seerr itself uses for Jellyfin.
JELLYFIN_URL=

# --- Limit per person (admins have no limit)
# At most REQUEST_LIMIT requests within REQUEST_LIMIT_DAYS days. 0 = no limit.
REQUEST_LIMIT=0
REQUEST_LIMIT_DAYS=7

# --- Weekly post of what's new in the library, e.g. "sun 18:00" (German day names work too: "so 18:00").
# Empty = off.
WEEKLY_DIGEST=
# Time zone for the weekly post and the dates the bot shows, e.g. Europe/Zurich
TIMEZONE=UTC

# --- Quality or language to choose from when requesting
# Names of quality profiles in Radarr (movies) and Sonarr (shows), comma-separated, e.g. HD-1080p,Ultra-HD
# The first one is preselected. Empty = Seerr's default profile, no choice.
MOVIE_PROFILES=
TV_PROFILES=
