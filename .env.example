# Copy to .env and fill in. Keep .env private (chmod 600): it holds the bot token and the Seerr API key.

# --- Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# (not the Public Key or the Client Secret; no quotes needed)
DISCORD_TOKEN=
# Turn on Developer Mode (User Settings -> Advanced), then right-click -> "Copy ID"
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Only members with this role may search and request. Empty = everyone in the channel.
DISCORD_REQUEST_ROLE_ID=
# Who may delete movies and shows with /löschen: members with this role and/or these user IDs
# (comma-separated). Leave both empty to switch deleting off.
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_USER_IDS=

# --- Seerr
# Address the bot uses to reach Seerr
SEERR_URL=http://localhost:5055
# Seerr -> Settings -> General -> API Key
SEERR_API_KEY=
# Language of titles and descriptions
SEERR_LANGUAGE=de
# Empty: requests are made as the owner of the API key (an admin), so they are approved at once.
# A Seerr user ID: requests are made for that user. Without "auto-approve" they wait for approval in Seerr.
SEERR_USER_ID=
# Optional link to Seerr in the bot's messages, e.g. http://seerr.home (only if everyone in the channel can open it)
SEERR_PUBLIC_URL=

# --- Free space
# New requests are refused below this many GB free in Radarr's/Sonarr's folders; the bot also warns in the channel.
MIN_FREE_GB=15
